<?xml version="1.0" encoding="utf-8"?>
<!-- 浏览态副屏：主机列表里的一行，点击等同于点主屏上的主机卡。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="84dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/companion_key_bg"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <View
        android:id="@+id/hostDot"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:background="@drawable/companion_status_dot" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/hostName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/panel_text_strong"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/hostStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/panel_text_secondary"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/hostAction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/panel_accent"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
